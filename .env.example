# Public site origin, used for canonical URLs, sitemap.xml, robots.txt and Open Graph tags.
# Optional: leave it out entirely and the app falls back to FALLBACK_SITE_URL in lib/site.ts.
# A blank value is treated as "not set" rather than being used as-is.
# The protocol may be omitted (nexa.studio works); a trailing slash is stripped.
NEXT_PUBLIC_SITE_URL=https://nexa.studio

# Optional. Used only by `npm run images` (server-side script, never sent to the browser).
# Create a free app at https://unsplash.com/oauth/applications to get an access key.
UNSPLASH_ACCESS_KEY=
